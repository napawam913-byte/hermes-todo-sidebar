{
  "name": "hermes-todo-sidebar",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop todo sidebar prototype with Hermes sync placeholders.",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "vite --config apps/desktop/vite.config.ts --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.electron.json",
    "build:main": "tsc -p apps/desktop/tsconfig.electron.json",
    "build:renderer": "vite build --config apps/desktop/vite.config.ts",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "test": "vitest run --config apps/desktop/vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
