{
  "name": "hermes-todo-sidebar",
  "version": "0.1.0",
  "private": true,
  "author": "napawam913-byte",
  "description": "单机 Windows 待办桌宠，支持今日待办、周期计划与本地文件持久化。",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "vite --config apps/desktop/vite.config.ts --host 127.0.0.1 --port 5178",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.electron.json",
    "build:main": "tsc -p apps/desktop/tsconfig.electron.json",
    "build:renderer": "vite build --config apps/desktop/vite.config.ts",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "test": "vitest run --config apps/desktop/vite.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.napawam.hermesTodoSidebar",
    "productName": "Hermes 待办桌宠",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
